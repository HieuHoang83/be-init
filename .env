PORT=3000
NODE_ENV=development

MONGODB_DB_NAME=be_init

# Webhook rieng tu: copy "webhook authentication secret" o trang Thong bao
HARAVAN_WEBHOOK_SECRET=96cadd08f4c8098e65fcf39d5a45b125

# Webhook ket noi app
HARAVAN_APP_CLIENT_SECRET=b3bebfae6ebb4af0c5ad7cc7518323e2052d7406404c11f3d55698e92babd704
HARAVAN_APP_VERIFY_TOKEN=local-verify-token

HARAVAN_MIN_PRIOR_ORDERS=1

# --- OAuth (Haravan app) ---
# client_id 32 hex, client_secret 64 hex: lay o trang App trong Haravan Developer
HARAVAN_CLIENT_ID=96cadd08f4c8098e65fcf39d5a45b125
HARAVAN_CLIENT_SECRET=b3bebfae6ebb4af0c5ad7cc7518323e2052d7406404c11f3d55698e92babd704
# redirect_uri phai GION dung buoc authorize, sai so doi se invalid_grant
HARAVAN_REDIRECT_URI=https://0ba9-171-248-227-250.ngrok-free.app/api/v1/haravan/auth/callback
# authorization code chi dung MOT LAN va nganh, lay moi moi khi chay script
HARAVAN_AUTHORIZATION_CODE=

JWT_ACCESS_TOKEN_SECRET=UOrOq25_EBH4t_vi35qPXcGYNHjNYZ_rKzI21DzfdNWyCFc_VnPu4BJCIyGNeywV

# Omni API - token long-lived, can scope wh_api de subscribe webhook
# Chua co access_token hop le. Chay: node scripts/haravan-token.mjs <authorization-code>
HARAVAN_ACCESS_TOKEN=9B55A0565284EBE7122D6908CB3D409652DAE745347937690E2EB8834375A0DC
# Dien org_id cua shop (lay o trang Settings cua shop tren Haravan)
HARAVAN_ORG_ID=200001220496

# API subscribe webhook: POST/DELETE/GET https://webhook.haravan.com/api/subscribe
HARAVAN_WEBHOOK_API_BASE_URL=https://webhook.haravan.com

# Domain public de dung callback URL (ngrok)
PUBLIC_BASE_URL=https://b010-2401-d800-99b9-11c8-9dc9-b69d-3a16-8c07.ngrok-free.app
HARAVAN_OAUTH_SCOPES=openid profile address email phone org userinfo grant_service wh_api com.write_orders com.read_orders
# DEMO_APP (app-services-96cadd08f4c8098e65fcf39d5a45b125@s-200001220496.haravan.com) roles=admin
JWT_REFRESH_TOKEN_SECRET=Zl8vbOKh9otVqc-uVPXpqPfvUTedRFC7F5WZsl4uqukdE-S1LIduwOouI35KhrZm
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
MONGODB_USERNAME="hoangminhhieu271219_db_user"
MONGODB_PASSWORD="NDGuWK6g3GNHTZNt"
MONGODB_URI="mongodb+srv://hoangminhhieu271219_db_user:NDGuWK6g3GNHTZNt@cluster0.a7gfn5l.mongodb.net"

# Quy tac xu ly don hang bo sung
HARAVAN_MIN_PRIOR_SPENT=0
HARAVAN_ALLOW_CONFIRM_CONFIRMED=false

# Cau hinh ket noi API Haravan
HARAVAN_API_BASE_URL=https://apis.haravan.com/com
HARAVAN_API_TIMEOUT_MS=10000
HARAVAN_API_MAX_RETRIES=3
HARAVAN_API_RETRY_DELAY_MS=500

# Hang doi cong viec (bat JOB_QUEUE_ENABLED de job duoc chay)
HARAVAN_QUEUE_CONCURRENCY=5
HARAVAN_QUEUE_MAX_ATTEMPTS=3
HARAVAN_QUEUE_BACKOFF_BASE_MS=1000
HARAVAN_QUEUE_BACKOFF_MAX_MS=30000
JOB_QUEUE_ENABLED=true
JOB_QUEUE_POLL_INTERVAL_MS=1000
JOB_QUEUE_HEARTBEAT_INTERVAL_MS=4000
JOB_QUEUE_LEASE_MS=90000
JOB_QUEUE_RECLAIM_INTERVAL_MS=300000

# Elasticsearch (tim kiem khach hang)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=haravan
# Gom cong viec nap index: du 10 khach thi ghi ngay, it hon thi ghi moi 3 giay.
ELASTICSEARCH_BATCH_SIZE=10
ELASTICSEARCH_FLUSH_INTERVAL_MS=3000
ELASTICSEARCH_MAX_PENDING=2000
# Bo dem gom lo nam trong Redis nen moi tien trinh deu thay cung mot lo, va lo chua ghi xong con
# lai duoc cho lan chay sau thay vi mat khi may chet.
ELASTICSEARCH_REDIS_URL=redis://127.0.0.1:6379
ELASTICSEARCH_REDIS_KEY_PREFIX=haravan
# Nhac quet lo da het han (chi ap dung lo chua du ELASTICSEARCH_BATCH_SIZE).
ELASTICSEARCH_BATCH_TICK_MS=300
# So lan mot lo duoc ghi lai bo dem truoc khi chuyen sang hang doi cong viec.
ELASTICSEARCH_MAX_ATTEMPTS=5

# Dang nhap bang tai khoan Haravan (Haravan Connect)
HARAVAN_OPENID_ENABLED=true
HARAVAN_OPENID_REDIRECT_URI=https://0ba9-171-248-227-250.ngrok-free.app/api/v1/haravan/auth/callback

# Moi lan dang nhap deu phai duyet lai quyen (xoa dong nay de giu hanh vi mac dinh).
HARAVAN_OPENID_PROMPT=consent