# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# MongoDB
# uu tien dung atlas-credentials.env (MONGODB_USERNAME / MONGODB_PASSWORD /
# MONGODB_URI) - file nay da duoc them vao .gitignore
# ============================================
# Ten database trong Atlas (mac dinh: be_init)
MONGODB_DB_NAME=be_init
# Neu dung Atlas, dat cluster host o day (khong can khi da co MONGODB_URI day du)
# MONGODB_CLUSTER=cluster0.xxxxx.mongodb.net
# Neu khong dung Atlas, tro ve local:
# MONGODB_URI=mongodb://localhost:27017/be_init

# ============================================
# WEBHOOK RIENG TU (private webhook)
# Admin -> Cau hinh -> Thong bao -> Webhooks -> copy "authentication secret"
# Callback URL: https://<domain-cua-ban>/api/v1/webhooks/haravan
# Chi POST, khong co GET challenge
# ============================================
HARAVAN_WEBHOOK_SECRET=

# Multi-shop: map org_id -> webhook secret, dang JSON
# HARAVAN_ORG_SECRETS={"123456":"secret-a","789012":"secret-b"}

# ============================================
# WEBHOI KET NOI APP (app-based webhook)
# https://partners.haravan.com/apps
# Callback URL: https://<domain-cua-ban>/api/v1/webhooks/app
# GET = subscribe challenge, POST = nhan thong bao
# ============================================
# Client secret cua app, de verify HMAC thong bao tu app
HARAVAN_APP_CLIENT_SECRET=
# Verify token app ban dat, de xac nhan buoc subscribe
HARAVAN_APP_VERIFY_TOKEN=

# Multi-shop: map org_id -> app client secret, dang JSON
# HARAVAN_APP_ORG_SECRETS={"123456":"secret-a","789012":"secret-b"}

# ============================================
# Omni API credentials
# ============================================
# Long-lived access_token, scope: com.read_orders com.write_orders wh_api
HARAVAN_ACCESS_TOKEN=
# org_id cua shop, de xac dinh token dau dung (multi-shop se luu trong DB)
HARAVAN_ORG_ID=

# ============================================
# Rule auto-confirm
# ============================================
# So don khach da mua TRUOC don nay toi thieu de confirm (mac dinh 1)
HARAVAN_MIN_PRIOR_ORDERS=1
# Tong chi tieu toi thieu truoc don nay (VND), 0 = bo qua
HARAVAN_MIN_PRIOR_SPENT=0
# Cho phep confirm lai don da confirmed
HARAVAN_ALLOW_CONFIRM_CONFIRMED=false

# ============================================
# MongoDB job queue
# ============================================
HARAVAN_QUEUE_CONCURRENCY=5
HARAVAN_QUEUE_MAX_ATTEMPTS=3
HARAVAN_QUEUE_BACKOFF_BASE_MS=1000
HARAVAN_QUEUE_BACKOFF_MAX_MS=30000
JOB_QUEUE_ENABLED=true
JOB_QUEUE_POLL_INTERVAL_MS=1000
# Worker heartbeat moi 4 giay; reclaim lease neu qua 90 giay khong co heartbeat.
JOB_QUEUE_HEARTBEAT_INTERVAL_MS=4000
JOB_QUEUE_LEASE_MS=90000
# Quet job stale moi 5 phut va quet ngay khi worker khoi dong.
JOB_QUEUE_RECLAIM_INTERVAL_MS=300000

# ============================================
# Haravan API client
# ============================================
HARAVAN_API_BASE_URL=https://apis.haravan.com/com
HARAVAN_API_TIMEOUT_MS=10000
HARAVAN_API_MAX_RETRIES=3
HARAVAN_API_RETRY_DELAY_MS=500

# ============================================
# JWT (module auth sẵn có)
# ============================================
JWT_SECRET=change-me