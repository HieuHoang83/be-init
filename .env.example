# Máy chủ
PORT=3000
NODE_ENV=development

# Cơ sở dữ liệu MongoDB
MONGODB_DB_NAME=be_init
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Elasticsearch (tim kiem khach hang)
# De false thi tim kiem chay tren MongoDB, khong can Elasticsearch.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=haravan
ELASTICSEARCH_TIMEOUT_MS=5000
ELASTICSEARCH_MAX_RETRIES=2
# Gom cong viec nap index: ghi ngay khi du ELASTICSEARCH_BATCH_SIZE khach trong mot lo,
# neu it hon thi ghi khi het ELASTICSEARCH_FLUSH_INTERVAL_MS (tinh tu khach dau tien cua lo).
ELASTICSEARCH_BATCH_SIZE=10
ELASTICSEARCH_FLUSH_INTERVAL_MS=3000
# Bo dem cho phep giu bao nhieu khach khi Elasticsearch cham; vuot qua se chuyen sang hang doi.
ELASTICSEARCH_MAX_PENDING=2000
# Bo dem gom lo trong Redis. Khong co Redis thi moi khach duoc day thang vao hang doi cong viec.
ELASTICSEARCH_REDIS_URL=redis://127.0.0.1:6379
# Tien to ten key Redis; tach theo moi truong de khong lan sang nhau.
ELASTICSEARCH_REDIS_KEY_PREFIX=haravan
# Nhac quet lo da het han. Chi ap dung lo chua du ELASTICSEARCH_BATCH_SIZE.
ELASTICSEARCH_BATCH_TICK_MS=300
# So lan mot lo duoc ghi lai bo dem truoc khi chuyen sang hang doi cong viec de thu lai.
ELASTICSEARCH_MAX_ATTEMPTS=5

# Webhook riêng tư
HARAVAN_WEBHOOK_SECRET=
# HARAVAN_ORG_SECRETS={"123456":"secret-a","789012":"secret-b"}

# Webhook ứng dụng
HARAVAN_APP_CLIENT_SECRET=
HARAVAN_APP_VERIFY_TOKEN=
# HARAVAN_APP_ORG_SECRETS={"123456":"secret-a","789012":"secret-b"}

# API Haravan
HARAVAN_ACCESS_TOKEN=
HARAVAN_ORG_ID=

# Dang nhap bang tai khoan Haravan (Haravan Connect / OpenID Connect)
# Client ID/Secret lay o Haravan Partner Dashboard; redirect_uri phai khai bao
# o day va dang ky dung y chinh xac tren dashboard (khong duoc co query string).
HARAVAN_OPENID_ENABLED=true
HARAVAN_OPENID_ISSUER=https://accounts.haravan.com
HARAVAN_OPENID_CLIENT_ID=
HARAVAN_OPENID_CLIENT_SECRET=
# Nhan POST (form_post) tu Haravan, vi du https://your-app.com/api/v1/haravan/auth/callback
HARAVAN_OPENID_REDIRECT_URI=
# Trang frontend quay ve sau khi dang nhap xong (co the de trong neu BE tra JSON)
HARAVAN_OPENID_FRONTEND_REDIRECT_URI=
# Chi cho phep cac host nay trong ?redirect_uri= cua /haravan/auth/login
HARAVAN_OPENID_ALLOWED_REDIRECT_HOSTS=
# `org` bo sung claim orgid (shop) vao id_token
HARAVAN_OPENID_SCOPE=openid profile email org
# code = Authorization Code Flow + PKCE; doi neu dashboard yeu cau code id_token
HARAVAN_OPENID_RESPONSE_TYPE=code
# Tu tao user moi o lan dang nhap dau tien; role phai ton tai trong collection `roles`
HARAVAN_OPENID_AUTO_PROVISION=true
HARAVAN_OPENID_DEFAULT_ROLE=Assistant Admin
# Chi cho phep tai khoan thuoc shop nay dang nhap; bo trong = moi shop
HARAVAN_OPENID_ORG_ID=
HARAVAN_OPENID_STATE_TTL_MS=600000

# Quy tắc xử lý đơn hàng
HARAVAN_MIN_PRIOR_ORDERS=1
HARAVAN_MIN_PRIOR_SPENT=0
HARAVAN_ALLOW_CONFIRM_CONFIRMED=false

# Hàng đợi công việc
HARAVAN_QUEUE_CONCURRENCY=5
HARAVAN_QUEUE_MAX_ATTEMPTS=3
HARAVAN_QUEUE_BACKOFF_BASE_MS=1000
HARAVAN_QUEUE_BACKOFF_MAX_MS=30000
JOB_QUEUE_ENABLED=true
JOB_QUEUE_POLL_INTERVAL_MS=1000
JOB_QUEUE_HEARTBEAT_INTERVAL_MS=4000
JOB_QUEUE_LEASE_MS=90000
JOB_QUEUE_RECLAIM_INTERVAL_MS=300000

# Cấu hình kết nối API Haravan
HARAVAN_API_BASE_URL=https://apis.haravan.com/com
HARAVAN_API_TIMEOUT_MS=10000
HARAVAN_API_MAX_RETRIES=3
HARAVAN_API_RETRY_DELAY_MS=500

# Token JWT
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
